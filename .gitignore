# Build output
/dist/
*.test
*.out

# The frontend is built into the Go module's embed directory. The directory
# itself is tracked (with a placeholder) so that `go build` works in a fresh
# clone; its contents are generated by `make web`.
/internal/server/static/dist/*
!/internal/server/static/dist/.gitkeep

# Frontend
/web/node_modules/
/web/.svelte-kit/
/web/build/
/web/.env
/web/.env.*
!/web/.env.example

# Local state
*.db
*.db-shm
*.db-wal

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
