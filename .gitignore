# Build output
/dist/
*.test
*.out

# The frontend is built into the Go module's embed directory by `make web`.
# The placeholder that keeps the embed pattern satisfied in a fresh clone sits
# beside the output rather than inside it: the SvelteKit build empties its own
# output directory, so a tracked file in there would be deleted on every build
# and leave the tree dirty for goreleaser.
/internal/server/static/dist/

# Frontend
/web/node_modules/
/web/.svelte-kit/
/web/build/
/web/.env
/web/.env.*
!/web/.env.example

# Local state
*.db
*.db-shm
*.db-wal

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
